# Auth — set to true in .env.local for local development without Cloudflare Access
# DISABLE_AUTH is silently ignored in production (VERCEL_ENV=production / NODE_ENV=production)
DISABLE_AUTH=

# Cloudflare Access JWT verification (strongly recommended for production)
# Set these to enable strict JWT verification instead of plain header trust.
# CF_ACCESS_TEAM_DOMAIN: e.g. https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD: Access Application Audience tag (Zero Trust → Access → Apps → AUD Tag)
# CF_ACCESS_ALLOWED_EMAILS: optional comma-separated allowlist e.g. user@example.com,other@example.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=

# Cron (node-cron in-process; also gates the /api/cron/* endpoints)
CRON_SECRET=

# Cloudflare Tunnel token (AWS deploy only — the instance's only ingress).
# Zero Trust -> Networks -> Tunnels -> create -> copy token.
TUNNEL_TOKEN=

# siglens-core infra (Redis used for OAuth token cache, accountSeq cache, and distributed lock)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Data sources
FMP_API_KEY=
MARKET_DATA_PROVIDER=fmp

# LLM provider API keys — required for direct analysis calls (worker removed)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Toss Securities Open API (OAuth2 client_credentials)
TOSS_APP_KEY=          # OAuth2 client_id
TOSS_SECRET_KEY=       # OAuth2 client_secret
# TOSS_ACCOUNT_NO removed — accountSeq resolved dynamically via GET /api/v1/accounts

# DB
DATABASE_URL=

# Notifications
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=noreply@siglens.io
